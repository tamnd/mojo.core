def Properties() -> Dict[String, RangeTable]:
    """Go's `unicode.Properties`: the binary properties, by name.

    A new `Dict` on every call, with 35 entries. The named
    tables above are the same data and cost nothing, so reach for one of
    those unless the name is only known at run time.
    """
    var out = Dict[String, RangeTable]()
    out["ASCII_Hex_Digit"] = ASCII_Hex_Digit
    out["Bidi_Control"] = Bidi_Control
    out["Dash"] = Dash
    out["Deprecated"] = Deprecated
    out["Diacritic"] = Diacritic
    out["Extender"] = Extender
    out["Hex_Digit"] = Hex_Digit
    out["Hyphen"] = Hyphen
    out["IDS_Binary_Operator"] = IDS_Binary_Operator
    out["IDS_Trinary_Operator"] = IDS_Trinary_Operator
    out["Ideographic"] = Ideographic
    out["Join_Control"] = Join_Control
    out["Logical_Order_Exception"] = Logical_Order_Exception
    out["Noncharacter_Code_Point"] = Noncharacter_Code_Point
    out["Other_Alphabetic"] = Other_Alphabetic
    out[
        "Other_Default_Ignorable_Code_Point"
    ] = Other_Default_Ignorable_Code_Point
    out["Other_Grapheme_Extend"] = Other_Grapheme_Extend
    out["Other_ID_Continue"] = Other_ID_Continue
    out["Other_ID_Start"] = Other_ID_Start
    out["Other_Lowercase"] = Other_Lowercase
    out["Other_Math"] = Other_Math
    out["Other_Uppercase"] = Other_Uppercase
    out["Pattern_Syntax"] = Pattern_Syntax
    out["Pattern_White_Space"] = Pattern_White_Space
    out["Prepended_Concatenation_Mark"] = Prepended_Concatenation_Mark
    out["Quotation_Mark"] = Quotation_Mark
    out["Radical"] = Radical
    out["Regional_Indicator"] = Regional_Indicator
    out["Sentence_Terminal"] = Sentence_Terminal
    out["Soft_Dotted"] = Soft_Dotted
    out["Terminal_Punctuation"] = Terminal_Punctuation
    out["Unified_Ideograph"] = Unified_Ideograph
    out["Variation_Selector"] = Variation_Selector
    out["White_Space"] = White_Space
    out["STerm"] = STerm
    return out^


def FoldCategory() -> Dict[String, RangeTable]:
    """Go's `unicode.FoldCategory`: the fold exceptions of each category, by name.

    A new `Dict` on every call, with 6 entries. The named
    tables above are the same data and cost nothing, so reach for one of
    those unless the name is only known at run time.
    """
    var out = Dict[String, RangeTable]()
    out["L"] = _fold_L
    out["Ll"] = _fold_Ll
    out["Lt"] = _fold_Lt
    out["Lu"] = _fold_Lu
    out["M"] = _fold_M
    out["Mn"] = _fold_Mn
    return out^


def FoldScript() -> Dict[String, RangeTable]:
    """Go's `unicode.FoldScript`: the fold exceptions of each script, by name.

    A new `Dict` on every call, with 3 entries. The named
    tables above are the same data and cost nothing, so reach for one of
    those unless the name is only known at run time.
    """
    var out = Dict[String, RangeTable]()
    out["Common"] = _fold_Common
    out["Greek"] = _fold_Greek
    out["Inherited"] = _fold_Inherited
    return out^


def CategoryAliases() -> Dict[String, String]:
    """Go's `unicode.CategoryAliases`: `Uppercase_Letter` is `Lu`.

    The long names Unicode gives the general categories, mapped to the
    two letter ones the tables above are keyed by. Nothing in this
    package reads it; it is here because a program taking a category
    name from a user has to accept both spellings.
    """
    var out = Dict[String, String]()
    out["Cased_Letter"] = "LC"
    out["Close_Punctuation"] = "Pe"
    out["Combining_Mark"] = "M"
    out["Connector_Punctuation"] = "Pc"
    out["Control"] = "Cc"
    out["Currency_Symbol"] = "Sc"
    out["Dash_Punctuation"] = "Pd"
    out["Decimal_Number"] = "Nd"
    out["Enclosing_Mark"] = "Me"
    out["Final_Punctuation"] = "Pf"
    out["Format"] = "Cf"
    out["Initial_Punctuation"] = "Pi"
    out["Letter"] = "L"
    out["Letter_Number"] = "Nl"
    out["Line_Separator"] = "Zl"
    out["Lowercase_Letter"] = "Ll"
    out["Mark"] = "M"
    out["Math_Symbol"] = "Sm"
    out["Modifier_Letter"] = "Lm"
    out["Modifier_Symbol"] = "Sk"
    out["Nonspacing_Mark"] = "Mn"
    out["Number"] = "N"
    out["Open_Punctuation"] = "Ps"
    out["Other"] = "C"
    out["Other_Letter"] = "Lo"
    out["Other_Number"] = "No"
    out["Other_Punctuation"] = "Po"
    out["Other_Symbol"] = "So"
    out["Paragraph_Separator"] = "Zp"
    out["Private_Use"] = "Co"
    out["Punctuation"] = "P"
    out["Separator"] = "Z"
    out["Space_Separator"] = "Zs"
    out["Spacing_Mark"] = "Mc"
    out["Surrogate"] = "Cs"
    out["Symbol"] = "S"
    out["Titlecase_Letter"] = "Lt"
    out["Unassigned"] = "Cn"
    out["Uppercase_Letter"] = "Lu"
    out["cntrl"] = "Cc"
    out["digit"] = "Nd"
    out["punct"] = "P"
    return out^
