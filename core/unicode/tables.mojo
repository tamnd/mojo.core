def Categories() -> Dict[String, RangeTable]:
    """Go's `unicode.Categories`: the general categories, by name.

    A new `Dict` on every call, with 38 entries. The named
    tables above are the same data and cost nothing, so reach for one of
    those unless the name is only known at run time.
    """
    var out = Dict[String, RangeTable]()
    out["C"] = C
    out["Cc"] = Cc
    out["Cf"] = Cf
    out["Cn"] = Cn
    out["Co"] = Co
    out["Cs"] = Cs
    out["L"] = L
    out["LC"] = LC
    out["Ll"] = Ll
    out["Lm"] = Lm
    out["Lo"] = Lo
    out["Lt"] = Lt
    out["Lu"] = Lu
    out["M"] = M
    out["Mc"] = Mc
    out["Me"] = Me
    out["Mn"] = Mn
    out["N"] = N
    out["Nd"] = Nd
    out["Nl"] = Nl
    out["No"] = No
    out["P"] = P
    out["Pc"] = Pc
    out["Pd"] = Pd
    out["Pe"] = Pe
    out["Pf"] = Pf
    out["Pi"] = Pi
    out["Po"] = Po
    out["Ps"] = Ps
    out["S"] = S
    out["Sc"] = Sc
    out["Sk"] = Sk
    out["Sm"] = Sm
    out["So"] = So
    out["Z"] = Z
    out["Zl"] = Zl
    out["Zp"] = Zp
    out["Zs"] = Zs
    return out^


