    assert_equal(sprintf["%#.4e"](_f64(0x3FF0000000000000)), "1.0000e+00")
    assert_equal(sprintf["%#.4x"](_f64(0x3FF0000000000000)), "0x1.0000p+00")
    assert_equal(sprintf["%#.4g"](_f64(0x3FF0000000000000)), "1.000")
